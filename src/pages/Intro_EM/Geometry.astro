import Image from "../../components/Image.astro"
import DisplayTable from "../../components/DisplayTable.astro";
import Warning from "../../components/Warning.astro";
import InlineCanvas from "../../components/InlineCanvas.astro";
import Row from "../../components/Row.astro";
import Col from "../../components/Col.astro";
    



---

<Layout title="Symbols, Units, and Constants">

    <div slot="navtree">
        <ul class='list-group list-group-flush py-0'> 
            <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='#symbols'>Symbols</a>
                <ul class='list-group list-group-flush py-0'> 
                    <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='#greek'>Greek letters</a></li> 
					<li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='#math-symbols'>Mathematical Symbols</a></li> 
					
                </ul>
            </li>
            <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='#units'>Units</a>
			<ul class='list-group list-group-flush py-0'> 
                   <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='#base-units'>Base Units</a></li>
				   <li class='list-group-item py-0'><a class='text-decoration-none subsubsection' href='#prefixes'>Prefixes</a></li> 
                </ul></li>
            <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='#constants'>Constants</a></li>
        </ul>
    </div>



<Section id="main-section" title="Symbols, Units, and Constants">
        <p>
            This page provides a key to interpreting symbols and units in Introductory Electricity & Magnetism, and provides values of constants in SI units.
        </p>
        

        <Warning title="Read me if you plan to copy/paste this page into your course!" id="copy-paste">
            Because of where this page is in github, the insert components section at the top of the code is a little different. After copy/pasting this page into your course, remove one '../' from each component line at the top.
            All insert components statements in the text here and in the style guide have the correct path structure and do not need to be changed. 
        </Warning>

        <p>
            Good luck!
        </p>

        <p>
            This section of your page should be a brief intro to the topic of the page. Keep it short and sweet here!
        </p>
    </Section>

<SubSection id="symbols" title="Symbols">
	
	
            
    <SubSubSection id="greek" title="Greek letters">
        <DisplayTable id="id" class_="mb-3">
        <thead>
        <tr>
            <th class="table-shaded" noborder>Symbol</th>
            <th class="table-shaded">Name</th>
            <th class="table-shaded">Meaning in Physics 102</th>
            
        </tr>
        </thead>
        <tbody>
		<tr>
            <td><InlineEquation equation="\\gamma" /></td>
            <td>gamma</td>
            <td>Symbol for high-energy EM wave</td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="\\Delta" /></td>
            <td>Delta</td>
            <td>Symbol for change in a quantity</td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="\\epsilon" /> or <InlineEquation equation="\\varepsilon" /></td>
            <td>epsilon</td>
            <td>Electric polarizability of a material ("permittivity")<br>Careful: Similar to emf symbol <InlineEquation equation="\\mathcal{E}" /></td>
            
        </tr>
				<tr>
            <td><InlineEquation equation="\\theta" /></td>
            <td>theta</td>
            <td>Angle</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\kappa" /></td>
            <td>kappa</td>
            <td>Dielectric constant of a material</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\lambda" /></td>
            <td>lambda</td>
            <td>Wavelength</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\mu" /></td>
            <td>mu</td>
            <td>Linear (charge) density<br>OR<br>Magnetization in a material in a magnetic field</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\pi" /></td>
            <td>pi</td>
            <td>The ratio of a circle's circumference to its diameter</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\rho" /></td>
            <td>rho</td>
            <td>Volume (charge) density</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\sigma" /></td>
            <td>sigma (lower case)</td>
            <td>Area density<br>or<br>Blackbody radiation constant</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\Sigma" /></td>
            <td>Sigma (upper case)</td>
            <td>The sum of the following quantity</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\tau" /></td>
            <td>tau</td>
            <td>Symbol for torque<br>OR<br>Symbol for time constant in a circuit</td>
            
        </tr>

		<tr>
            <td><InlineEquation equation="\\phi" /></td>
            <td>phi (lower case)</td>
            <td>Angle</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\Phi" /></td>
            <td>Phi (upper case)</td>
            <td>Symbol for flux</td>
            
        </tr>
        </tbody>
    </DisplayTable>
    

    

        <CalloutContainer slot="cards">
            <CalloutCard title="The symbol 𝛑">
                Although the concept of 𝛑 has existed since at least the ancient Egyptians, the first known use of the symbol 𝛑 for its mathematical purpose was in 1706. <a target="_blank" rel="noopener noreferrer" href="https://www.historytoday.com/archive/feature/man-who-invented-pi" >More information on the adoption of this symbol.</a>
            </CalloutCard>
        </CalloutContainer>
	</SubSubSection>
	
	    <SubSubSection id="math-symbols" title="Mathematical Symbols">
		<p>This section uses the placeholder variable <InlineEquation equation="A" />. You may use any relevant variable in its place.</p>
        <DisplayTable id="id" class_="mb-3">
        <thead>
        <tr>
            <th class="table-shaded" noborder>Symbol</th>
            <th class="table-shaded">Meaning</th>
            <th class="table-shaded">Use/Definition</th>
            
        </tr>
        </thead>
        <tbody>
		<tr>
            <td><InlineEquation equation="\\Delta" /></td>
            <td>Change</td>
            <td><InlineEquation equation="\\Delta A =A_{final}-A_{initial}" /></td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\sum{}" /></td>
            <td>Sum</td>
            <td>For a series of quantities <InlineEquation equation="A_1" />, <InlineEquation equation="A_2" />, <InlineEquation equation="A_3" />, etc., <InlineEquation equation="\\sum A =A_{1}+A_{2}+A_{3}+\\cdots" /></td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="\\vec{A}" /></td>
            <td>Vector symbol</td>
            <td>The variable represents a vector quantity with magnitude and direction.<br>May also be drawn with partial arrow <InlineEquation equation="\\stackrel{\\rightharpoonup}{A}" /></td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="|\\vec{A}|" /></td>
            <td>Vector magnitude</td>
            <td>The magnitude of the vector <InlineEquation equation="\\vec{A}" /><br>If <InlineEquation equation="\\vec{A}" /> is known to be a vector, the magnitude may also be written as <InlineEquation equation="A" /></td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="A_x" /></td>
            <td>x-component of vector A</td>
            <td>The projection of the vector <InlineEquation equation="\\vec{A}" /> (magnitude and direction) onto the x axis.<br>Similarly, <InlineEquation equation="A_y" /> and <InlineEquation equation="A_z" /> are the projections of <InlineEquation equation="\\vec{A}" /> onto the y and z axes, respectively.</td>
          
        </tr>
		<tr>
            <td><InlineEquation equation="A_\\parallel" /></td>
            <td>Parallel component notation</td>
            <td>The component of vector <InlineEquation equation="\\vec{A}" /> that is parallel to a second reference vector.</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="A_\\perp" /></td>
            <td>Perpendicular component notation</td>
            <td>The component of vector <InlineEquation equation="\\vec{A}" /> that is perpendicular to a second reference vector.</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="A(x)" /></td>
            <td><InlineEquation equation="A" /> as a function of the variable <InlineEquation equation="x" /></td>
            <td>An expression for the value of <InlineEquation equation="A" /> for any input value of the variable <InlineEquation equation="x" />.<br>Be careful: <InlineEquation equation="A(x)" /> does <b>not</b> mean <InlineEquation equation="A\\times x" /></td>
          
        </tr>
		<tr>
            <td><InlineEquation equation="A_0" /></td>
            <td>Initial value of <InlineEquation equation="A" /></td>
            <td>Typically, the value of <InlineEquation equation="A" /> when <InlineEquation equation="t=0" />.<br>In function format, <InlineEquation equation="A(t=0)=A_0" /><br>May be said as "A naught".</td>
          
        </tr>
		<tr>
            <td><InlineEquation equation="\\arccos(A)" /> <br>or<br> <InlineEquation equation="\\cos^{-1}(A)" /></td>
            <td>Inverse cosine of <InlineEquation equation="A" /><br>Similar for other trigonometric functions.</td>
            <td>Inverse of the cosine function.<br>Finds the value of <InlineEquation equation="\\theta" /> that gives <InlineEquation equation="\\cos(\\theta)=A" /><br>May appear as "acos" on some calculators.</td>
            
        </tr>
		
        </tbody>
    </DisplayTable>
    

    

	</SubSubSection>
	
	
		
    </SubSection>

 

    <SubSection id="units" title="Units">
        <p>
            You can add little cards to the side of each section. These are meant to contain extra information not critical to what's discussed in the section, such as fun-facts, extra readings related to the material, or real-world applications. 
        </p>
       
	   
	   
	  <SubSubSection id="base-units" title="Base Units and Unit Construction">
	  <p>Physics uses SI units - that is, it constructs all units out of seconds, meters, kilograms, amperes, kelvins, and moles.</p>
	  
	   <DisplayTable id="id" class_="mb-3">
        <thead>
        <tr>
            <th class="table-shaded" noborder>Unit (Symbol)</th>
            <th class="table-shaded">Quantity</th>
            <th class="table-shaded">Construction from base units</th>
            
        </tr>
        </thead>
        <tbody>
		<tr>
            <td>meters (m)</td>
            <td>Length, distance</td>
            <td><InlineEquation equation="\\mathrm{m}" /></td>
            
        </tr>
		<tr>
            <td>kilograms (kg)</td>
            <td>Mass</td>
            <td><InlineEquation equation="\\mathrm{kg}" /></td>
            
        </tr>
		<tr>
            <td>seconds (s)</td>
            <td>Time</td>
            <td><InlineEquation equation="\\mathrm{s}" /></td>
            
        </tr>
		<tr>
            <td>Newtons (N)</td>
            <td>Force</td>
            <td><InlineEquation equation="\\mathrm{kg}\\frac{\\mathrm{m}}{\\mathrm{s^2}}" /></td>
            
        </tr>
		<tr>
            <td>Joules (J)</td>
            <td>Energy</td>
            <td><InlineEquation equation="\\mathrm{kg}\\frac{\\mathrm{m^2}}{\\mathrm{s^2}}" /></td>
            
        </tr>
		<tr>
            <td>Watts (W)</td>
            <td>Power</td>
            <td><InlineEquation equation="\\mathrm{kg}\\frac{\\mathrm{m^2}}{\\mathrm{s^3}}" /></td>
            
        </tr>
        <tr>
            <td>Coulombs (C)</td>
            <td>Charge</td>
            <td><InlineEquation equation="\\mathrm{A}\\cdot \\mathrm{s}" /></td>
            
        </tr>
		<tr>
            <td>Volts (V)</td>
            <td>Electric Potential</td>
             <td><InlineEquation equation="\\mathrm{kg}\\frac{\\mathrm{m^2}}{\\mathrm{s}^3 \\cdot \\mathrm{A}}" /></td>
            
        </tr>
		<tr>
            <td>Amperes (A)</td>
            <td>Electric Current</td>
            <td><InlineEquation equation="\\mathrm{A}" /></td>
            
        </tr>
		<tr>
            <td>Ohms (<InlineEquation equation="\\Omega" />)</td>
            <td>Resistance</td>
             <td><InlineEquation equation="\\mathrm{kg}\\frac{\\mathrm{m^2}}{\\mathrm{s}^3 \\cdot \\mathrm{A}^2}" /></td>
            
        </tr>
		<tr>
            <td>Weber (W)</td>
            <td>Magnetic flux</td>
             <td><InlineEquation equation="\\mathrm{kg}\\frac{\\mathrm{m^2}}{\\mathrm{s}^2 \\cdot \\mathrm{A}}" /></td>
            
        </tr>
		<tr>
            <td>Farad (F)</td>
            <td>Capacitance</td>
             <td><InlineEquation equation="\\mathrm{A}^2\\frac{\\mathrm{s^4}}{\\mathrm{kg} \\cdot \\mathrm{m}^2}" /></td>
            
        </tr>
        </tbody>
    </DisplayTable>
	
	
	  </SubSubSection>
    </SubSection>

    <SubSection id="images" title="Adding Images">
        
        <p>
            You can also add images with or without a caption. For info on where images should be saved at, see the <a href="/about/instructions/mechse#setup">setup page</a>. More info on formatting images is in the <a href="/about/docs#images"> Style guide & documentation</a>.
        </p>
        <Image src="/sol/bending/Geometry.png" width="4"> Add caption here if you want one </Image>
