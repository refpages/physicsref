<Section id="main-section" title="Symbols, Units, and Constants">
        <p>
            This page provides a key to interpreting symbols and units in Introductory Electricity & Magnetism, and provides values of constants in SI units.
        </p>
        

        
</Section>

<SubSection id="symbols" title="Symbols">
	
	
            

            
    <SubSubSection id="greek" title="Greek letters">
        <DisplayTable id="id" class_="mb-3">
        <thead>
        <tr>
            <th class="table-shaded" noborder>Symbol</th>
            <th class="table-shaded">Name</th>
            <th class="table-shaded">Meaning in Physics 102</th>
            
        </tr>
        </thead>
        <tbody>
		<tr>
            <td><InlineEquation equation="\\gamma" /></td>
            <td>gamma</td>
            <td>Symbol for high-energy EM wave</td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="\\Delta" /></td>
            <td>Delta</td>
            <td>Symbol for change in a quantity</td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="\\epsilon" /> or <InlineEquation equation="\\varepsilon" /></td>
            <td>epsilon</td>
            <td>Electric polarizability of a material ("permittivity")<br>Careful: Similar to emf symbol <InlineEquation equation="\\mathcal{E}" /></td>
            
        </tr>
				<tr>
            <td><InlineEquation equation="\\theta" /></td>
            <td>theta</td>
            <td>Angle</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\kappa" /></td>
            <td>kappa</td>
            <td>Dielectric constant of a material</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\lambda" /></td>
            <td>lambda</td>
            <td>Wavelength</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\mu" /></td>
            <td>mu</td>
            <td>Linear (charge) density<br>OR<br>Magnetization in a material in a magnetic field</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\pi" /></td>
            <td>pi</td>
            <td>The ratio of a circle's circumference to its diameter</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\rho" /></td>
            <td>rho</td>
            <td>Volume (charge) density</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\sigma" /></td>
            <td>sigma (lower case)</td>
            <td>Area density<br>or<br>Blackbody radiation constant</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\Sigma" /></td>
            <td>Sigma (upper case)</td>
            <td>The sum of the following quantity</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\tau" /></td>
            <td>tau</td>
            <td>Symbol for torque<br>OR<br>Symbol for time constant in a circuit</td>
            
        </tr>

		<tr>
            <td><InlineEquation equation="\\phi" /></td>
            <td>phi (lower case)</td>
            <td>Angle</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\Phi" /></td>
            <td>Phi (upper case)</td>
            <td>Symbol for flux</td>
            
        </tr>
        </tbody>
    </DisplayTable>
    

    

      
	</SubSubSection>
	
	    <SubSubSection id="math-symbols" title="Mathematical Symbols">
		<p>This section uses the placeholder variable <InlineEquation equation="A" />. You may use any relevant variable in its place.</p>
        <DisplayTable id="id" class_="mb-3">
        <thead>
        <tr>
            <th class="table-shaded" noborder>Symbol</th>
            <th class="table-shaded">Meaning</th>
            <th class="table-shaded">Use/Definition</th>
            
        </tr>
        </thead>
        <tbody>
		<tr>
            <td><InlineEquation equation="\\Delta" /></td>
            <td>Change</td>
            <td><InlineEquation equation="\\Delta A =A_{final}-A_{initial}" /></td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="\\sum{}" /></td>
            <td>Sum</td>
            <td>For a series of quantities <InlineEquation equation="A_1" />, <InlineEquation equation="A_2" />, <InlineEquation equation="A_3" />, etc., <InlineEquation equation="\\sum A =A_{1}+A_{2}+A_{3}+\\cdots" /></td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="\\vec{A}" /></td>
            <td>Vector symbol</td>
            <td>The variable represents a vector quantity with magnitude and direction.<br>May also be drawn with partial arrow <InlineEquation equation="\\stackrel{\\rightharpoonup}{A}" /></td>
            
        </tr>
        <tr>
            <td><InlineEquation equation="|\\vec{A}|" /></td>
            <td>Vector magnitude</td>
            <td>The magnitude of the vector <InlineEquation equation="\\vec{A}" /><br>If <InlineEquation equation="\\vec{A}" /> is known to be a vector, the magnitude may also be written as <InlineEquation equation="A" /></td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="A_x" /></td>
            <td>x-component of vector A</td>
            <td>The projection of the vector <InlineEquation equation="\\vec{A}" /> (magnitude and direction) onto the x axis.<br>Similarly, <InlineEquation equation="A_y" /> and <InlineEquation equation="A_z" /> are the projections of <InlineEquation equation="\\vec{A}" /> onto the y and z axes, respectively.</td>
          
        </tr>
		<tr>
            <td><InlineEquation equation="A_\\parallel" /></td>
            <td>Parallel component notation</td>
            <td>The component of vector <InlineEquation equation="\\vec{A}" /> that is parallel to a second reference vector.</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="A_\\perp" /></td>
            <td>Perpendicular component notation</td>
            <td>The component of vector <InlineEquation equation="\\vec{A}" /> that is perpendicular to a second reference vector.</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="A(x)" /></td>
            <td><InlineEquation equation="A" /> as a function of the variable <InlineEquation equation="x" /></td>
            <td>An expression for the value of <InlineEquation equation="A" /> for any input value of the variable <InlineEquation equation="x" />.<br>Be careful: <InlineEquation equation="A(x)" /> does <b>not</b> mean <InlineEquation equation="A\\times x" /></td>
          
        </tr>
		<tr>
            <td><InlineEquation equation="A_0" /></td>
            <td>Initial value of <InlineEquation equation="A" /></td>
            <td>Typically, the value of <InlineEquation equation="A" /> when <InlineEquation equation="t=0" />.<br>In function format, <InlineEquation equation="A(t=0)=A_0" /><br>May be said as "A naught".</td>
          
        </tr>
		<tr>
            <td><InlineEquation equation="\\arccos(A)" /> <br>or<br> <InlineEquation equation="\\cos^{-1}(A)" /></td>
            <td>Inverse cosine of <InlineEquation equation="A" /><br>Similar for other trigonometric functions.</td>
            <td>Inverse of the cosine function.<br>Finds the value of <InlineEquation equation="\\theta" /> that gives <InlineEquation equation="\\cos(\\theta)=A" /><br>May appear as "acos" on some calculators.</td>
            
        </tr>
		
        </tbody>
    </DisplayTable>
    

    

	</SubSubSection>
	
		
    </SubSection>

 

    <SubSection id="units" title="Units and SI Prefixes">
        <p>
            Introductory Physics uses meters, kilograms, and seconds as its base SI units (sometimes called 'mks'). When calculating, most units should be converted to their 10<sup>0</sup> form (no prefix). However, kilograms should be converted to the 10<sup>3</sup> form. Whenever you're not sure, check the units in the constant(s) you are using for calculations.
        </p>
       
	   
	   
	 
       <DisplayTable id="id" class_="mb-3">
        <thead>
        <tr>
            <th class="table-shaded" noborder>Power</th>
            <th class="table-shaded">Prefix</th>
            <th class="table-shaded">Symbol</th>
            
        </tr>
        </thead>
        <tbody>
		<tr>
            <td><InlineEquation equation="10^{12}" /></td>
            <td>tera</td>
            <td>T</td>
            
        </tr>
		<tr>
            <td><InlineEquation equation="10^{9}" /></td>
            <td>giga</td>
            <td>G</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{6}" /></td>
            <td>mega</td>
            <td>M</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{3}" /></td>
            <td>kilo</td>
            <td>k</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{0}" /></td>
            <td>&mdash;</td>
            <td>&mdash;</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{-2}" /></td>
            <td>centi</td>
            <td>c</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{-3}" /></td>
            <td>milli</td>
            <td>m</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{-6}" /></td>
            <td>micro</td>
            <td>&mu;</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{-9}" /></td>
            <td>nano</td>
            <td>n</td>
        </tr>
		<tr>
            <td><InlineEquation equation="10^{-12}" /></td>
            <td>pico</td>
            <td>p</td>
        </tr>
        
        </tbody>
    </DisplayTable>
	
    </SubSection>

<SubSection id="constants" title="Constants">
		<p>These constants will be used in calculations. You do not need to memorize them.</p>
        <DisplayTable id="id" class_="mb-3">
        <thead>
        <tr>
            <th class="table-shaded" noborder>Name</th>
            <th class="table-shaded">Symbol</th>
            <th class="table-shaded">Value</th>
            
        </tr>
        </thead>
        <tbody>
		<tr>
            <td>Gravity of Earth</td>
            <td><InlineEquation equation="g" /></td>
            <td><InlineEquation equation="9.8\\mbox{ m/s}^2" /></td>
            
        </tr>
		<tr>
            <td>Gravitational Constant</td>
            <td><InlineEquation equation="G" /></td>
            <td><InlineEquation equation="6.67\\times 10^{-11}\\mbox{ m}^3/\\mbox{kg}\\,\\mbox{s}^2" /></td>
            
        </tr>
		<tr>
            <td>Electron charge</td>
            <td><InlineEquation equation="e" /></td>
            <td><InlineEquation equation="1.6\\times 10^{-19}\\mbox{ C}" /></td>
            
        </tr>
		<tr>
            <td>Electron mass</td>
            <td><InlineEquation equation="m_e" /></td>
            <td><InlineEquation equation="9.11\\times 10^{-31}\\mbox{ kg}" /><br><InlineEquation equation="511\\mbox{ keV}/\\mbox{c}^2" /></td>
            
        </tr>
		<tr>
            <td>Proton mass</td>
            <td><InlineEquation equation="m_p" /></td>
            <td><InlineEquation equation="1.673\\times 10^{-27}\\mbox{ kg}" /><br><InlineEquation equation="938\\mbox{ keV}/\\mbox{c}^2" /></td>
            
        </tr>
		<tr>
            <td>Neutron mass</td>
            <td><InlineEquation equation="m_n" /></td>
            <td><InlineEquation equation="1.675\\times 10^{-27}\\mbox{ kg}" /><br><InlineEquation equation="939.5\\mbox{ keV}/\\mbox{c}^2" /></td>
            
        </tr>
		<tr>
            <td>Coulomb constant</td>
            <td><InlineEquation equation="k" /></td>
            <td><InlineEquation equation="8.99\\times 10^{9}\\mbox{ N}\\,\\mbox{m}^2/\\mbox{C}^2" /><br>Alternatively, <InlineEquation equation="k=\\frac{1}{4\\pi\\varepsilon_0}" /></td>
            
        </tr>
        <tr>
            <td>Permittivity of free space</td>
            <td><InlineEquation equation="\\varepsilon_0" /></td>
            <td><InlineEquation equation="8.85\\times 10^{-12}\\mbox{ C}^2/\\mbox{N}\\,\\mbox{m}^2" /></td>
            
        </tr>
        <tr>
            <td>Magnetic permeability of free space</td>
            <td><InlineEquation equation="\\mu_0" /></td>
            <td><InlineEquation equation="1.257\\times 10^{-6}\\mbox{ T}\\,\\mbox{m}/\\mbox{A}^2" /><br><InlineEquation equation="4\\pi\\times 10^{-7}\\mbox{ T}\\,\\mbox{m}/\\mbox{A}^2" /></td>
            
        </tr>
		<tr>
            <td>Speed of light in vacuum</td>
            <td><InlineEquation equation="c" /></td>
            <td><InlineEquation equation="3\\times 10^{8}\\mbox{ m}/\\mbox{s}" /><br>Alternatively, <InlineEquation equation="c=\\frac{1}{\\sqrt{\\varepsilon_0 \\mu_0}}" /></td>
            
        </tr>
		<tr>
            <td>Planck constant</td>
            <td><InlineEquation equation="h" /></td>
            <td><InlineEquation equation="6.626\\times 10^{-34}\\mbox{ J}\\,\\mbox{s}"  /></td>
            
        </tr>
		<tr>
            <td>Electron volt (unit conversion)</td>
            <td><InlineEquation equation="eV" /></td>
            <td><InlineEquation equation="1\\mbox{ eV}=1.6\\times 10^{-19}\\mbox{ J}"  /></td>
            
        </tr>
		
        </tbody>
    </DisplayTable>
    

    

	</SubSection>

</Layout>
